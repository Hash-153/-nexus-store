# Application Environment Configuration
PORT=3000
NODE_ENV=production
APP_NAME=enterprise-ecommerce-platform
LOG_LEVEL=info

# Event Bus & Cache Settings
EVENT_BUS_CONCURRENCY=10
CACHE_TTL_SECONDS=3600

# Security (Set in production environment)
APP_SECRET=your_secure_random_application_secret_here
TOKEN_EXPIRATION_HOURS=24
