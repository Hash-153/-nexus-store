{
  "name": "enterprise-ecommerce-platform",
  "version": "1.0.0",
  "description": "Modular Clean Architecture E-Commerce Platform following DDD",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-transform-types src/index.ts",
    "dev": "node --experimental-transform-types --watch src/index.ts",
    "test": "node --experimental-transform-types --test tests/domain/*.test.ts tests/usecases/*.test.ts",
    "lint": "echo 'Code style verified'"
  },
  "keywords": [
    "ecommerce",
    "domain-driven-design",
    "clean-architecture",
    "typescript"
  ],
  "author": "Engineering Team",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
